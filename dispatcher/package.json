{
  "name": "claude-code-vm-job-dispatcher",
  "version": "1.0.0",
  "description": "Claude-on-VM autonomous fixer: self-polls JobLander Linear 'monitor' tickets and drives prod bug fixes to merge (self-healing loop, no human in the loop)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch & node --watch dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.0",
    "express": "^4.21.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.6.0"
  }
}
