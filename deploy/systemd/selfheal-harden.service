[Unit]
Description=Self-healing host hardening — converge memory caps, DHCP lease survival, earlyoom
Documentation=file:__AGENT_HOME__/self-healing/deploy/bin/self-healing-harden.sh

[Service]
EnvironmentFile=-/etc/self-healing/deploy.env
Type=oneshot
User=root
ExecStart=__AGENT_HOME__/self-healing/deploy/bin/self-healing-harden.sh
# apt may wait on the unattended-upgrades dpkg lock (600 s in the script).
TimeoutStartSec=900
