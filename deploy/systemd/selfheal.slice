[Unit]
Description=Self-healing loop workloads — memory-capped so the agent can never starve the host
Before=slices.target

# WHY THIS EXISTS (incident 2026-08-26, six-day blindness).
# The dispatcher ran in system.slice with no memory limit. A single
# investigation session grew until the host had no free memory; the kernel
# spent 40 minutes thrashing page cache (48 GB read per 5 min, PD line rate)
# and, mid-stall, systemd-networkd's DHCPv4 renewal on ens4 timed out and the
# link went Failed. The global OOM killer then freed the memory — too late:
# the lease expired an hour later, ens4 lost its address, and the VM ran
# blind (no metadata server, no Cloud Logging, no SSH) until it was reset.
#
# The fix is not a bigger machine, it is a bounded one: everything the agent
# runs lives in this slice, so runaway memory is charged to a cgroup that the
# kernel kills locally instead of a host-wide OOM that takes networking with
# it. The host keeps ~3.4 GB for sshd, systemd-networkd, the guest agent and
# the observability stack no matter what the agent does.

[Slice]
MemoryAccounting=yes
# 8 GB machine (e2-standard-2). Budget, worst case:
#   selfheal.slice (dispatcher + change-ingest)      4 GB
#   user-1001.slice (cron: watcher, monitor session) 1.75 GB
#   system + observability (grafana, prometheus, caddy, sshd, networkd) ~1.2 GB
#   -> 6.95 GB of 7.94 GB, ~1 GB of real headroom with every ceiling hit at
#      once, and earlyoom fires at ~640 MB available, so the host is defended
#      before that headroom is gone.
#
# SIZED FROM MEASUREMENT, not guesswork (2026-09-02, first day under caps):
#   dispatcher memory.peak   1.41 GiB
#   slice      memory.peak   2.11 GiB
#   slice memory.events      high=12299  max=0  oom_kill=0
# Nothing was killed, but the soft threshold was crossed 12k times — real
# sessions live close to the line. The first cut also had the slice's
# MemoryHigh (3G) equal to the dispatcher's MemoryMax (3G), so the dispatcher
# could never reach its own ceiling without the slice throttling first; a
# parent's limits must sit above any single child's. Raised accordingly.
MemoryHigh=3500M
MemoryMax=4G
