[Unit]
Description=Claude-Code-VM Job Dispatcher — autonomous self-poll fixer for JobLander 'monitor' tickets (self-healing loop)
After=network.target

[Service]
Type=simple
User=joblander
WorkingDirectory=/home/joblander/self-healing/dispatcher
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=10
EnvironmentFile=/home/joblander/self-healing/dispatcher/.env

[Install]
WantedBy=multi-user.target
