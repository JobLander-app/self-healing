[Unit]
Description=Claude-Code-VM Job Dispatcher — autonomous self-poll fixer for configured monitor tickets (self-healing loop)
After=network.target

StartLimitIntervalSec=0

[Service]
Type=simple
User=__AGENT_USER__
WorkingDirectory=__AGENT_HOME__/self-healing/dispatcher
ExecStart=/usr/bin/python3 __AGENT_HOME__/self-healing/config/run.py -- /usr/bin/node dist/index.js
Restart=always
RestartSec=10
EnvironmentFile=__AGENT_HOME__/self-healing/dispatcher/.env

Slice=selfheal.slice
MemoryAccounting=yes
MemoryHigh=2500M
MemoryMax=3G
# A cgroup OOM kill must not be treated as "the service should stay dead".
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
