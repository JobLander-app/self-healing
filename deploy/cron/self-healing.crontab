# Installed as the dedicated agent user's entire crontab. Edit the profile, not the host copy.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
WATCH_NOTIFY_SCRIPT=__AGENT_HOME__/self-healing/deploy/bin/self-healing-notify.py

# Write the external heartbeat only after a successful tick.
* * * * * cd __AGENT_HOME__/self-healing/watcher && /usr/bin/flock -n __AGENT_HOME__/.output-watch.lock /usr/bin/python3 ../config/run.py -- /usr/bin/node dist/tick.js >> __AGENT_HOME__/output-watch.log 2>&1 && touch __AGENT_HOME__/.watcher-last-ok && /usr/bin/python3 ../config/run.py -- bash -c 'gcloud logging write self-healing-watcher "WATCHER_HEARTBEAT tick ok" --project="$GCP_PROJECT" --severity=INFO' >/dev/null 2>&1
0 * * * * systemd-cat -t self-healing-monitor __AGENT_HOME__/self-healing/monitor/run-monitor-session.sh
*/5 * * * * curl -sf --max-time 10 http://localhost:4100/health 2>/dev/null | grep -q '"status":"ok"' && /usr/bin/python3 __AGENT_HOME__/self-healing/config/run.py -- bash -c 'gcloud logging write self-healing-dispatcher "DISPATCHER_HEARTBEAT ok" --project="$GCP_PROJECT" --severity=INFO' >/dev/null 2>&1
* * * * * /usr/bin/python3 __AGENT_HOME__/self-healing/config/run.py -- /usr/bin/python3 __AGENT_HOME__/self-healing/deploy/bin/publish-events.py >> __AGENT_HOME__/self-healing-events.log 2>&1
